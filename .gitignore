# Public repository allowlist. Local research and device data stay private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/native/
!/readme/
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/android.yml

**/.gradle/
**/.kotlin/
**/build/
**/.idea/
**/local.properties
**/signing.local.properties
**/*.iml
**/*.apk
**/*.aab
**/*.idsig
**/*.jks
**/*.keystore
**/*.log
**/.DS_Store
